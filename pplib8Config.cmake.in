@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)

if(@ZLIB_FOUND@)
    find_dependency(ZLIB)
endif()
if(@BZip2_FOUND@)
    find_dependency(BZip2)
endif()
if(@Iconv_FOUND@)
    find_dependency(Iconv)
endif()
if(@OpenSSL_FOUND@)
    find_dependency(OpenSSL)
endif()
if(@JPEG_FOUND@)
    find_dependency(JPEG)
endif()
if(@PNG_FOUND@)
    find_dependency(PNG)
endif()
if(@TIFF_FOUND@)
    find_dependency(TIFF)
endif()
if(@Freetype_FOUND@)
    find_dependency(Freetype)
endif()
if(@CURL_FOUND@)
    find_dependency(CURL)
endif()
if(@SQLite3_FOUND@)
    find_dependency(SQLite3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/pplib8Targets.cmake")
